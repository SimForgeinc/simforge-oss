{
  "name": "@simforge-oss/trace-render",
  "version": "0.1.0-rc.9",
  "description": "Deterministic 2D renderer for SimForge instance and trace evidence.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/simforge-oss.git",
    "directory": "packages/trace-render"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.mjs",
  "bin": {
    "simforge-trace-render": "./bin/trace-render.js"
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.mjs" },
    "./underlay": { "types": "./src/underlay.d.ts", "default": "./src/underlay.mjs" }
  },
  "files": ["bin", "src"],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
