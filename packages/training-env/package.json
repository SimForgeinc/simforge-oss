{
  "name": "@simforge-oss/training-env",
  "version": "0.1.0-rc.64",
  "description": "Gymnasium-semantics environment façades over the SimForge native runtime: EnvSession (reset/step), SessionBatch, PolicySession, WorldSession with the truth-stream wire, and the versioned causal ground-truth channel.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/simforge-oss.git",
    "directory": "packages/training-env"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    }
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "development": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "development": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/node.ts src/browser.ts --format esm --dts --sourcemap --clean --no-splitting --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@simforge-oss/engine": "workspace:*",
    "@simforge-oss/native-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
