{
  "name": "@simforge-oss/engine",
  "version": "0.1.0-rc.64",
  "description": "SimForge engine contracts (scenario input, trace, evaluation, scene-state) and the Node/WASM façades over the native runtime.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/simforge-oss.git",
    "directory": "packages/engine"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "./scene-state": {
        "types": "./dist/scene-state/index.d.ts",
        "default": "./dist/scene-state/index.js"
      }
    }
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "development": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "development": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./scene-state": {
      "development": "./src/scene-state/index.ts",
      "types": "./dist/scene-state/index.d.ts",
      "default": "./dist/scene-state/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@simforge-oss/native-runtime": "workspace:*",
    "@simforge-oss/scenario": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/node.ts src/browser.ts src/scene-state/index.ts --format esm --dts --sourcemap --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
