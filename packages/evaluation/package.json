{
  "name": "@simforge-oss/evaluation",
  "version": "0.1.0-rc.61",
  "description": "WS5 EvalHarness — frozen policy evaluation protocol: versioned suite (policy-eval-suite.v1), deterministic env server over the suite entries, and suite-hash-keyed report inputs. The Python runner lives under qualification/policy-eval-runner.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimForgeinc/simforge-oss",
    "directory": "packages/evaluation"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./params": {
        "types": "./dist/protocol/params.d.ts",
        "default": "./dist/protocol/params.js"
      },
      "./protocol": {
        "types": "./dist/protocol/index.d.ts",
        "default": "./dist/protocol/index.js"
      },
      "./replay-context": {
        "types": "./dist/replay-context/index.d.ts",
        "default": "./dist/replay-context/index.js"
      }
    }
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "simforge-evaluation-build-suite": "./dist/build-suite-cli.js",
    "simforge-evaluation-server": "./dist/eval-server.js",
    "simforge-eval-campaign": "./dist/campaign-cli.js",
    "simforge-eval-worker": "./dist/worker-cli.js",
    "simforge-eval-rig": "./dist/rig-cli.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./params": {
      "development": "./src/protocol/params.ts",
      "types": "./dist/protocol/params.d.ts",
      "default": "./dist/protocol/params.js"
    },
    "./protocol": {
      "development": "./src/protocol/index.ts",
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./replay-context": {
      "development": "./src/replay-context/index.ts",
      "types": "./dist/replay-context/index.d.ts",
      "default": "./dist/replay-context/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/protocol/index.ts src/protocol/params.ts src/build-suite-cli.ts src/eval-server.ts src/campaign-cli.ts src/worker-cli.ts src/rig-cli.ts src/examiner/extractor/cli.ts --format esm --dts --sourcemap --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@simforge-oss/compiler": "workspace:*",
    "@simforge-oss/engine": "workspace:*",
    "@simforge-oss/scenario": "workspace:*",
    "@simforge-oss/training-env": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
