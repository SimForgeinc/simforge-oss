{
  "name": "@simforge-oss/native-runtime",
  "version": "0.1.0-rc.62",
  "description": "SimForge native runtime for Node (N-API) and the browser (WASM): scenario loading, compilation, simulation, sessions, batches and live worlds over typed arrays.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/simforge-oss.git",
    "directory": "packages/native-runtime"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "./shared": {
        "types": "./dist/shared.d.ts",
        "default": "./dist/shared.js"
      }
    }
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "development": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./shared": {
      "development": "./src/shared.ts",
      "types": "./dist/shared.d.ts",
      "default": "./dist/shared.js"
    }
  },
  "files": [
    "THIRD_PARTY_NOTICES",
    "dist",
    "native/index.d.ts",
    "native/*.node",
    "wasm/*.js",
    "wasm/*.wasm",
    "wasm/*.d.ts"
  ],
  "napi": {
    "binaryName": "simforge-native-runtime",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build:node": "napi build --manifest-path ../../native/crates/simforge-bindings-node/Cargo.toml --platform --release --output-dir native --dts index.d.ts --no-js",
    "build:node:debug": "napi build --manifest-path ../../native/crates/simforge-bindings-node/Cargo.toml --platform --output-dir native --dts index.d.ts --no-js",
    "build:wasm": "wasm-pack build ../../native/crates/simforge-bindings-wasm --release --target web --out-dir ../../../packages/native-runtime/wasm --out-name simforge_native_runtime --no-pack && node scripts/prepare-wasm.mjs",
    "build:ts": "tsup src/index.ts src/browser.ts src/shared.ts --format esm --dts --sourcemap --clean --out-dir dist --external ../wasm/simforge_native_runtime.js",
    "build": "pnpm run build:node && pnpm run build:wasm && pnpm run build:ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wasm-pack": "^0.13.1"
  }
}
