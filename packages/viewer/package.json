{
  "name": "@simforge-oss/viewer",
  "version": "0.1.0-rc.75.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimForgeinc/simforge-oss.git",
    "directory": "packages/viewer"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./asset-variants": {
        "types": "./dist/asset-variants.d.ts",
        "default": "./dist/asset-variants.js"
      }
    }
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "development": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./asset-variants": {
      "development": "./src/asset-variants.ts",
      "types": "./dist/asset-variants.d.ts",
      "default": "./dist/asset-variants.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@simforge-oss/asset-catalog": "workspace:*",
    "@simforge-oss/engine": "workspace:*",
    "@simforge-oss/maps": "workspace:*",
    "@simforge-oss/scenario": "workspace:*",
    "ktx-parse": "1.1.0",
    "three": "^0.185.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react-dom": "^19.2.0",
    "jsdom": "^29.1.1",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/three": "^0.185.0",
    "react": "^19.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx src/asset-variants.ts --format esm --dts --sourcemap --clean --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite dev --config dev/vite.config.ts"
  }
}
