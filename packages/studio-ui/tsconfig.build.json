{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    // Sibling packages resolve through their published `types`, not the
    // workspace `development` source condition, so emit stays under `src`.
    "customConditions": [],
    "paths": {}
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/__tests__/**"],
  "include": ["src"]
}
