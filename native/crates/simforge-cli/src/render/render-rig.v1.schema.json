{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simforge.ai/schemas/simforge.render-rig/v1.json",
  "title": "simforge.render-rig/v1",
  "description": "The sensor rig `simforge render --rig` renders. `sources` and `sensorHosts` are the hosted render intent's `renderSpec.sources` (RenderSourceV3) and `sensorHosts`, field for field, so a rig copied from a hosted render request renders unchanged. Without `sensorHosts` every source is hosted by its own actorId (the host's vehicle asset is its timeline catalog id); without `clip` the whole timeline is rendered. Both are reported in results.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": "simforge.render-rig/v1"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "sensorHosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "actorId",
          "vehicleAsset"
        ],
        "properties": {
          "sourceId": {
            "$ref": "#/$defs/outputName"
          },
          "actorId": {
            "type": "string",
            "minLength": 1
          },
          "vehicleAsset": {
            "type": "object",
            "required": [
              "catalogAssetId"
            ],
            "properties": {
              "catalogAssetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startSeconds",
        "endSeconds"
      ],
      "description": "[startSeconds, endSeconds) of timeline (clip-relative) time.",
      "properties": {
        "startSeconds": {
          "type": "number",
          "minimum": 0
        },
        "endSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps",
        "container",
        "codec",
        "quality"
      ],
      "description": "The native engine encodes mp4 + h264 (libx264 CRF 18); fps also sets the radar sample schedule.",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "container": {
          "enum": [
            "mp4",
            "webm"
          ]
        },
        "codec": {
          "enum": [
            "h264",
            "vp9",
            "av1"
          ]
        },
        "quality": {
          "enum": [
            "draft",
            "standard",
            "high",
            "lossless"
          ]
        }
      }
    }
  },
  "$defs": {
    "outputName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "vec3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position"
      ],
      "description": "Actor-local metres: +X forward, +Y up, +Z left. Rotation yaw (+Y, CCW), then pitch (+Z), then roll (+X).",
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "yawRad": {
              "type": "number",
              "minimum": -3.141592653589793,
              "maximum": 3.141592653589793,
              "default": 0
            },
            "pitchRad": {
              "type": "number",
              "minimum": -1.5707963267948966,
              "maximum": 1.5707963267948966,
              "default": 0
            },
            "rollRad": {
              "type": "number",
              "minimum": -3.141592653589793,
              "maximum": 3.141592653589793,
              "default": 0
            }
          }
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actorId",
            "sensorId",
            "outputName",
            "transform",
            "modality",
            "attributes"
          ],
          "properties": {
            "actorId": {
              "type": "string",
              "minLength": 1
            },
            "sensorId": {
              "type": "string",
              "minLength": 1
            },
            "sensorLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "outputName": {
              "$ref": "#/$defs/outputName"
            },
            "transform": {
              "$ref": "#/$defs/transform"
            },
            "modality": {
              "enum": [
                "rgb",
                "depth",
                "semantic",
                "instance"
              ],
              "description": "The native engine renders rgb; the other camera modalities are refused (native_modality_unsupported)."
            },
            "attributes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "width",
                "height",
                "fps",
                "horizontalFovDeg",
                "nearM",
                "farM"
              ],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 64,
                  "maximum": 8192
                },
                "height": {
                  "type": "integer",
                  "minimum": 64,
                  "maximum": 8192
                },
                "fps": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 240
                },
                "horizontalFovDeg": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 180
                },
                "nearM": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "farM": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actorId",
            "sensorId",
            "outputName",
            "transform",
            "modality",
            "attributes"
          ],
          "properties": {
            "actorId": {
              "type": "string",
              "minLength": 1
            },
            "sensorId": {
              "type": "string",
              "minLength": 1
            },
            "sensorLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "outputName": {
              "$ref": "#/$defs/outputName"
            },
            "transform": {
              "$ref": "#/$defs/transform"
            },
            "modality": {
              "const": "lidar"
            },
            "attributes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "channels",
                "rangeM",
                "pointsPerSecond",
                "rotationFrequencyHz",
                "upperFovDeg",
                "lowerFovDeg"
              ],
              "properties": {
                "channels": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 256
                },
                "rangeM": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "pointsPerSecond": {
                  "type": "integer",
                  "minimum": 1
                },
                "rotationFrequencyHz": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 240
                },
                "upperFovDeg": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "lowerFovDeg": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180,
                  "description": "The native service's fan is symmetric: lowerFovDeg must equal -upperFovDeg."
                },
                "horizontalFovDeg": {
                  "type": "number",
                  "minimum": 5,
                  "maximum": 360,
                  "default": 360
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actorId",
            "sensorId",
            "outputName",
            "transform",
            "modality",
            "attributes"
          ],
          "properties": {
            "actorId": {
              "type": "string",
              "minLength": 1
            },
            "sensorId": {
              "type": "string",
              "minLength": 1
            },
            "sensorLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "outputName": {
              "$ref": "#/$defs/outputName"
            },
            "transform": {
              "$ref": "#/$defs/transform"
            },
            "modality": {
              "const": "radar"
            },
            "attributes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "horizontalFovDeg",
                "verticalFovDeg",
                "rangeM",
                "pointsPerSecond"
              ],
              "properties": {
                "horizontalFovDeg": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 180
                },
                "verticalFovDeg": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 180
                },
                "rangeM": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "pointsPerSecond": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      ]
    }
  }
}
