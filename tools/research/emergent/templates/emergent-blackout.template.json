{
  "scenarioVersion": 2,
  "meta": {
    "name": "Emergent probe: signal blackout over dense ambient traffic — does a four-way stop emerge?",
    "description": "Bonus probe (rethink stream C). Ego approaches a signalized 4-arm junction through dense ambient traffic; at t=2 s every head of the junction is set to 'off' via @world set signal:feature:*:{ego,opposing,left,right}.phase. Engine dark-fallback semantics (signals.ts authorityAt) degrade every dark head to a coordinated all-way stop (one coordinationId per junction), so the registered question is whether an implicit four-way-stop NEGOTIATION emerges in the ambient population: alternating entries, yield-stops, hesitation deadlocks — mined with the pre-registered M3 thresholds.",
    "createdAt": "2026-08-16T00:00:00.000Z",
    "modifiedAt": "2026-08-16T00:00:00.000Z",
    "appVersion": "uniscenarios/0.0.1",
    "archetype": "emergent.signal-blackout",
    "tags": ["emergent", "harvest", "ambient", "junction", "blackout", "negotiation"],
    "author": "agent/rethink-emergent",
    "negativeControl": false
  },
