  "weather": "clear",
  "timeOfDay": "noon"
 },
 "anchor": {
  "id": "c2probe-lead-baseline",
  "corridor": {
   "throughLanesSameDir": {
    "value": [
     1,
     8
    ],
    "essentiality": "required"
   },
   "speedLimitKph": {
    "value": [
     40,
     80
    ],
    "essentiality": "required"
   },
   "curvatureDegPer10m": {
    "value": [
     0,
     6
    ],
    "essentiality": "required"
   },
   "runwayDownstreamM": {
    "value": [
     300,
     null
    ],
    "essentiality": "required"
   }
  },
  "features": [],
  "policy": {
   "allowMirror": false,
   "maxSitesPerMap": 6,
   "diversity": "moderate",
   "minScore": 0.5
  }
 },
 "roles": [
  {
   "id": "ego",
   "kind": "on_reference",
   "label": "vehicle under test",
   "actor": {
    "class": "car",
    "catalogId": "vehicle.sedan"
   },
   "pose": {
    "laneOffset": 0,
    "s": 30,
    "tFrac": 0,
    "headingOffsetRad": 0
   },
   "initialSpeedKph": 40.0
  },
  {
   "id": "chal",
   "kind": "relative_to",
   "label": "slower lead vehicle",
   "actor": {
    "class": "car",
    "catalogId": "vehicle.suv"
   },
   "requiredSameSegmentAs": "ego",
   "requiredHeadingRelation": {
    "role": "ego",
    "relation": "parallel",
    "maxErrorDeg": 10
   },
   "ref": "ego",
   "dLane": 0,
   "dsM": "param.initialGapM",
   "tFrac": 0,
   "headingOffsetRad": 0,
   "initialSpeedKph": "20"
  }
 ],
 "props": [],
