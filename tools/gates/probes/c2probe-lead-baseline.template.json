    "id": "initialGapM",
    "type": "continuous",
    "unit": "m",
    "tier": 1,
    "range": [
     26,
     60
    ],
    "default": 42,
    "distribution": "uniform"
   },
   {
    "id": "brakeAtTtcS",
    "type": "continuous",
    "unit": "s",
    "tier": 1,
