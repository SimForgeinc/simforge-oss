    "id": "ego-holds-course",
    "actor": "ego",
    "verb": "set",
    "trigger": {
     "kind": "at",
     "t": 0
    },
    "target": {
     "key": "rules.collisionAvoidance",
     "value": false
    }
   },
   {
    "id": "ego-brakes",
    "actor": "ego",
    "verb": "speed",
    "trigger": {
     "kind": "at",
     "t": "clamp(param.initialGapM / 5.5556 - param.brakeAtTtcS, 0.2, 12)"
    },
    "target": {
     "mode": "stop"
    },
    "dynamics": {
     "shape": "linear",
     "constraint": "rate",
     "value": 6.0
    }
   }
  ]
