{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simforge.ai/contracts/scenario-package/receipt.v1.schema.json",
  "title": "simforge.scenario-package-receipt/v1",
  "description": "receipt.json of a scenario package: the export event, canonical JSON, outside the package identity. Readers display it and never decide from it, but refuse one that contradicts its container (packageId, form, embeddedBlobs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "embeddedBlobs",
    "exportedAt",
    "exporterRelease",
    "form",
    "packageId",
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "simforge.scenario-package-receipt/v1"
    },
    "packageId": {
      "$ref": "#/$defs/sha256"
    },
    "form": {
      "enum": [
        "thin",
        "full"
      ]
    },
    "exportedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "exporterRelease": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "textureTier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "embeddedBlobs": {
      "$ref": "#/$defs/countBytes"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hex sha256."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339, UTC."
    },
    "countBytes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "bytes",
        "count"
      ]
    }
  }
}
