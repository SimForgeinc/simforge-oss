{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simforge.ai/contracts/scenario-package/manifest.v1.schema.json",
  "title": "simforge.scenario-package/v1 manifest",
  "description": "manifest.json of a SimForge scenario package (docs/engineering/scenario-package.md). The file holds exactly canonicalJson(manifest) (simforge.canonical-json/v1) and its sha256 is the package id. This schema is the shape; the reader (the simforge-package crate) also enforces the cross-field rules this schema cannot express: documentSchema names scenarioVersion, traceSchema names traceFormat, groundDigest is null before trace format 5, and from format 5 it is present exactly when the trace ran on a ground surface: required and equal to the sha256 of map/closure.json's derived/ground/ground-mesh.bin when the closure lists one, null when it does not (spec section 8.1, rule 10), members[] is sorted by path and names every required role, member digests equal their typed digest fields (map/closure.json = map.canonicalClosureSha256, map/web-closure.json = map.webClosureSha256, null exactly when absent), timelines[] and the timeline/ members name the same timelines, and render is set exactly when render/pin.json is a member.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog",
    "engine",
    "executionPackage",
    "extensions",
    "map",
    "members",
    "producer",
    "provenance",
    "render",
    "scenario",
    "schema",
    "simulation",
    "timelines"
  ],
  "properties": {
    "schema": {
      "const": "simforge.scenario-package/v1"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "description": "Producing application, e.g. simcloud, simforge-cli."
        },
        "appVersion": {
          "$ref": "#/$defs/semver"
        },
        "minCli": {
          "$ref": "#/$defs/semver",
          "description": "The oldest simforge CLI that reads this package; older readers refuse it (package_version_unsupported, dimension cli)."
        }
      },
      "required": [
        "app",
        "appVersion",
        "minCli"
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "documentSchema": {
          "type": "string",
          "pattern": "^simforge\\.scenario\\.v[1-9][0-9]*$"
        },
        "scenarioVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "simContentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "documentId": {
              "$ref": "#/$defs/id"
            },
            "revisionId": {
              "$ref": "#/$defs/id"
            },
            "revisionNumber": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "committedAt": {
              "$ref": "#/$defs/timestamp"
            }
          },
          "required": [
            "committedAt",
            "documentId",
            "revisionId",
            "revisionNumber"
          ]
        }
      },
      "required": [
        "contentSha256",
        "documentSchema",
        "scenarioVersion",
        "simContentSha256",
        "title"
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engineSemVer": {
          "$ref": "#/$defs/semver"
        },
        "solverVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "pipelineRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "engineVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            },
            "abiVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "buildDigest": {
              "$ref": "#/$defs/sha256"
            },
            "addonSha256": {
              "$ref": "#/$defs/sha256"
            },
            "sourceRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            }
          },
          "required": []
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        }
      },
      "required": [
        "build",
        "engineSemVer",
        "pipelineRevision",
        "release",
        "solverVersion"
      ]
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "simKey": {
          "$ref": "#/$defs/sha256"
        },
        "traceFormat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "traceSchema": {
          "type": "string",
          "pattern": "^simforge\\.trace/v[1-9][0-9]*$"
        },
        "traceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "traceGzipSha256": {
          "$ref": "#/$defs/sha256"
        },
        "authoredTraceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "resolvedInputDigest": {
          "$ref": "#/$defs/sha256"
        },
        "resolutionSha256": {
          "$ref": "#/$defs/sha256"
        },
        "trafficProvider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "trafficStepKey": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          ]
        },
        "trafficSha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "sumo": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "networkSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "runtimeVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
                },
                "wasmSha256": {
                  "$ref": "#/$defs/sha256"
                }
              },
              "required": [
                "networkSha256",
                "runtimeVersion",
                "wasmSha256"
              ]
            }
          ]
        },
        "groundDigest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ],
          "description": "sha256 of the ground mesh the trace was simulated on (trace header groundDigest). Null before trace format 5; from format 5 required exactly when map/closure.json lists derived/ground/ground-mesh.bin, and then equal to its sha256."
        },
        "producerKind": {
          "enum": [
            "inline",
            "runner",
            "cli",
            "editor"
          ]
        },
        "simulatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "authoredTraceSha256",
        "groundDigest",
        "producerKind",
        "resolutionSha256",
        "resolvedInputDigest",
        "simKey",
        "simulatedAt",
        "sumo",
        "traceFormat",
        "traceGzipSha256",
        "traceSchema",
        "traceSha256",
        "trafficProvider",
        "trafficSha256",
        "trafficStepKey"
      ]
    },
    "timelines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
          },
          "samplerVersion": {
            "type": "string",
            "pattern": "^simforge\\.timeline-sampler/[1-9][0-9]*$"
          },
          "timelineKey": {
            "$ref": "#/$defs/sha256"
          },
          "timelineSha256": {
            "$ref": "#/$defs/sha256"
          },
          "heightFieldDigest": {
            "$ref": "#/$defs/sha256"
          },
          "catalogDigest": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/sha256"
              }
            ]
          }
        },
        "required": [
          "catalogDigest",
          "heightFieldDigest",
          "samplerVersion",
          "timelineKey",
          "timelineSha256",
          "version"
        ]
      }
    },
    "executionPackage": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contract": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            },
            "xoscSha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "contract",
            "xoscSha256"
          ]
        }
      ]
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mapVersionId": {
          "$ref": "#/$defs/id"
        },
        "sourceMapId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "xodrSha256": {
          "$ref": "#/$defs/sha256"
        },
        "coordinateSystemSha256": {
          "$ref": "#/$defs/sha256"
        },
        "mapClosureDigest": {
          "$ref": "#/$defs/sha256"
        },
        "pinClosureSha256": {
          "$ref": "#/$defs/sha256"
        },
        "heightSourceDigest": {
          "$ref": "#/$defs/sha256"
        },
        "groundDigest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ],
          "description": "Equal to simulation.groundDigest."
        },
        "closure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "memberCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "bytes",
            "memberCount"
          ],
          "description": "Member count and total bytes of the canonical closure."
        },
        "canonicalClosureSha256": {
          "$ref": "#/$defs/sha256",
          "description": "sha256 of map/closure.json: the map registry release's canonical closure (map-closure.v1, kind canonical, metadata.master), byte for byte as the registry serves it; it lists the native render assets (master.gltf, geometry.bin) and every derivative built into them."
        },
        "webClosureSha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ],
          "description": "sha256 of map/web-closure.json (the release's web closure), or null when the release has none."
        },
        "registryReleaseDigest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ],
          "description": "sha256 of the registry release document (simforge.map-release.v1) whose closures these are, when the map version came from a registry."
        }
      },
      "required": [
        "canonicalClosureSha256",
        "closure",
        "coordinateSystemSha256",
        "groundDigest",
        "heightSourceDigest",
        "label",
        "mapClosureDigest",
        "mapVersionId",
        "pinClosureSha256",
        "registryReleaseDigest",
        "sourceMapId",
        "webClosureSha256",
        "xodrSha256"
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetCatalogVersionId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "catalogSha256": {
          "$ref": "#/$defs/sha256"
        },
        "actorClosureDigest": {
          "$ref": "#/$defs/sha256"
        },
        "actorClosureSchema": {
          "const": "simforge.actor-assets-closure/v1"
        },
        "catalogIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "referencedActorBlobs": {
          "$ref": "#/$defs/countBytes"
        }
      },
      "required": [
        "actorClosureDigest",
        "actorClosureSchema",
        "assetCatalogVersionId",
        "catalogIds",
        "catalogSha256",
        "referencedActorBlobs"
      ]
    },
    "members": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "const": "document.json"
              },
              "role": {
                "const": "document"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mediaType": {
                "const": "application/vnd.simforge.scenario+json"
              },
              "schema": {
                "type": "string",
                "pattern": "^simforge\\.scenario\\.v[1-9][0-9]*$"
              }
            },
            "required": [
              "mediaType",
              "path",
              "role",
              "schema",
              "sha256",
              "size"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "const": "simulation/trace.json.gz"
              },
              "role": {
                "const": "trace"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mediaType": {
                "const": "application/vnd.simforge.trace+json+gzip"
              },
              "schema": {
                "type": "string",
                "pattern": "^simforge\\.trace/v[1-9][0-9]*$"
              }
            },
            "required": [
              "mediaType",
              "path",
              "role",
              "schema",
              "sha256",
              "size"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "const": "simulation/resolution.json.gz"
              },
              "role": {
                "const": "resolution"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mediaType": {
                "const": "application/vnd.simforge.sim-resolution+json+gzip"
              },
              "schema": {
                "const": "simforge.sim-resolution/v1"
              }
            },
            "required": [
              "mediaType",
              "path",
              "role",
              "schema",
              "sha256",
              "size"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "const": "simulation/materialized-traffic.json"
              },
              "role": {
                "const": "traffic"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mediaType": {
                "const": "application/vnd.uniscenarios.materialized-traffic+json"
              }
            },
            "required": [
              "mediaType",
              "path",
              "role",
              "sha256",
              "size"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^timeline/[0-9a-f]{64}\\.json$"
              },
              "role": {
                "const": "timeline"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mediaType": {
                "const": "application/vnd.simforge.render-timeline+json"
              },
              "schema": {
                "const": "simforge.render-timeline.v1"
              }
            },
            "required": [
              "mediaType",
              "path",
              "role",
              "schema",
              "sha256",
              "size"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "const": "map/closure.json"
              },
              "role": {
                "const": "map-closure"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mediaType": {
                "const": "application/vnd.simforge.map-closure+json"
              },
              "schema": {
                "const": "map-closure.v1"
              }
            },
            "required": [
              "mediaType",
              "path",
              "role",
              "schema",
              "sha256",
              "size"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "const": "actors/closure.json"
              },
              "role": {
                "const": "actor-closure"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mediaType": {
                "const": "application/vnd.simforge.actor-assets-closure+json"
              },
              "schema": {
                "const": "simforge.actor-assets-closure/v1"
              }
            },
            "required": [
              "mediaType",
              "path",
              "role",
              "schema",
              "sha256",
              "size"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "const": "catalog/entries.json"
              },
              "role": {
                "const": "catalog"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mediaType": {
                "const": "application/json"
              }
            },
            "required": [
              "mediaType",
              "path",
              "role",
              "sha256",
              "size"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "const": "export/scenario.xosc"
              },
              "role": {
                "const": "xosc"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mediaType": {
                "const": "application/xml"
              }
            },
            "required": [
              "mediaType",
              "path",
              "role",
              "sha256",
              "size"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "const": "render/pin.json"
              },
              "role": {
                "const": "render-pin"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mediaType": {
                "const": "application/vnd.simforge.render-pin+json"
              },
              "schema": {
                "const": "simforge.render-pin/v1"
              }
            },
            "required": [
              "mediaType",
              "path",
              "role",
              "schema",
              "sha256",
              "size"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "const": "map/web-closure.json"
              },
              "role": {
                "const": "map-web-closure"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mediaType": {
                "const": "application/vnd.simforge.map-closure+json"
              },
              "schema": {
                "const": "map-closure.v1"
              }
            },
            "required": [
              "mediaType",
              "path",
              "role",
              "schema",
              "sha256",
              "size"
            ]
          }
        ]
      },
      "description": "Every member except manifest.json, receipt.json and blobs/, sorted by path. Blobs are listed by the two closure documents."
    },
    "render": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "reproduce-exactly"
            },
            "renderer": {
              "enum": [
                "native-bevy",
                "carla"
              ]
            },
            "imageDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "runtimeVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            },
            "rendererBuild": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            },
            "gpu": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "minLength": 1,
