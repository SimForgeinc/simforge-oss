+/// Finish every encoder of `items` (on up to `threads` scoped threads, each
+/// taking whole encoders) and return all buffers in `items` order.
+fn finish_in_order(items: Vec<Pending>, threads: usize) -> Vec<CommandBuffer> {
+    let encoders = items.iter().filter(|item| matches!(item, Pending::Encoder(_))).count();
+    if threads <= 1 || encoders <= 1 {
+        return items
+            .into_iter()
+            .map(|item| match item {
+                Pending::Buffer(buffer) => buffer,
+                Pending::Encoder(encoder) => encoder.finish(),
+            })
+            .collect();
