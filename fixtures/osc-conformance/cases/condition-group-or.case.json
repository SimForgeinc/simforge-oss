{
  "id": "condition-group-or",
  "feature": "Trigger OR over ConditionGroups",
  "osc": [
    "ConditionGroup (OR)",
    "RelativeDistanceCondition"
  ],
  "description": "Ego slows when it is within 40.5 m of car A (lane -1) OR of car B (lane -3, further ahead).",
  "clipSeconds": 10,
  "actors": [
    {
      "id": "ego",
      "lane": -2,
      "s": 50,
      "speedMps": 20
    },
    {
      "id": "a",
      "lane": -1,
      "s": 150,
      "speedMps": 10
    },
    {
      "id": "b",
      "lane": -3,
      "s": 200,
      "speedMps": 10
    }
  ],
  "interactions": [
    {
      "id": "change",
      "actorId": "ego",
      "verb": "speed",
      "target": {
        "mode": "absolute",
        "value": 10
      },
      "dynamics": {
        "shape": "cubic",
        "constraint": "time",
        "value": 3
      },
      "trigger": {
        "kind": "when",
        "condition": {
          "kind": "or",
          "of": [
            {
              "kind": "distance",
              "a": "ego",
              "b": "a",
              "mode": "euclidean",
              "cmp": "lt",
              "value": 40.5
            },
            {
              "kind": "distance",
              "a": "ego",
              "b": "b",
              "mode": "euclidean",
              "cmp": "lt",
              "value": 40.5
            }
          ]
        },
        "byLatest": 1000,
        "ifNever": "fire"
      }
    }
  ],
  "oracle": {
    "clauses": [
      "RelativeDistanceCondition (class reference: freespace, relativeDistanceType, coordinateSystem)",
      "7.6.1 Triggers and condition groups (OR of groups, AND within)",
      "7.6.2 Condition edges",
      "6.3.4 Vehicle coordinate system (reference point; BoundingBox.Center offset)"
    ],
    "derivation": "Freespace distances. Group 1 (car A) first true at 5.48 (see trigger-distance-euclidean); group 2 (car B, 150 m ahead) at 10.48. OR -> 5.48.",
    "actors": {
      "ego": {
        "x0": 50,
        "y0": -5.25,
        "v0": 20,
        "longitudinal": [
          {
            "t0": 5.48,
            "to": 10,
            "shape": "cubic",
            "durationS": 3
          }
        ]
      },
      "a": {
        "x0": 150,
        "y0": -1.75,
        "v0": 10
      },
      "b": {
        "x0": 200,
        "y0": -8.75,
        "v0": 10
      }
    },
    "events": {
      "change": {
        "start": 5.48
      }
    },
    "decisions": [
      "D-05",
      "D-06"
    ]
  },
  "expect": {
    "ours": "conforms",
    "esmini": "agrees"
  }
}
