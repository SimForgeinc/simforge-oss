{
  "id": "collision-condition-no-avoidance-rules",
  "feature": "CollisionCondition with SimForge avoidance switched off",
  "osc": [
    "CollisionCondition"
  ],
  "description": "As default-controller-no-avoidance, but the ego is authored with collisionAvoidance=false (the OSC default behaviour).",
  "clipSeconds": 5,
  "actors": [
    {
      "id": "ego",
      "lane": -2,
      "s": 50,
      "speedMps": 20,
      "overrides": {
        "behavior": {
          "rules": {
            "collisionAvoidance": false
          }
        }
      }
    },
    {
      "id": "parked",
      "lane": -2,
      "s": 100.1,
      "speedMps": 0
    },
    {
      "id": "other",
      "lane": -3,
      "s": 50,
      "speedMps": 20
    }
  ],
  "interactions": [
    {
      "id": "change",
      "actorId": "other",
      "verb": "speed",
      "target": {
        "mode": "absolute",
        "value": 25
      },
      "dynamics": {
        "shape": "linear",
        "constraint": "time",
        "value": 2
      },
      "trigger": {
        "kind": "when",
        "condition": {
          "kind": "collision",
          "a": "ego",
          "b": "parked"
        },
        "byLatest": 1000,
        "ifNever": "fire"
      }
    }
  ],
  "compareUntilS": 2.26,
  "oracle": {
    "clauses": [
      "7.4.1.1 Control strategy (default strategies: keep lane, keep current speed)",
      "CollisionCondition (class reference)"
    ],
    "derivation": "Same oracle as default-controller-no-avoidance: contact at the 2.28 tick.",
    "actors": {
      "ego": {
        "x0": 50,
        "y0": -5.25,
        "v0": 20
      },
      "parked": {
        "x0": 100.1,
        "y0": -5.25,
        "v0": 0
      },
      "other": {
        "x0": 50,
        "y0": -8.75,
        "v0": 20,
        "longitudinal": [
          {
            "t0": 2.28,
            "to": 25,
            "shape": "linear",
            "durationS": 2
          }
        ]
      }
    },
    "events": {
      "change": {
        "start": 2.28,
        "end": 4.28
      }
    },
    "decisions": [
      "D-06",
      "D-14"
    ]
  },
  "expect": {
    "ours": "conforms",
    "esmini": "agrees",
    "note": "The OSC default controller expressed in SimForge: reactive rules off, cruise target = initial speed. Exports without warnings."
  }
}
