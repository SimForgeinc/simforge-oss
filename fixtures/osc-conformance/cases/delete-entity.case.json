{
  "id": "delete-entity",
  "feature": "DeleteEntityAction at a SimulationTime",
  "osc": [
    "DeleteEntityAction"
  ],
  "description": "A car in lane -3 is removed at t=2 s.",
  "clipSeconds": 4,
  "actors": [
    {
      "id": "ego",
      "lane": -2,
      "s": 50,
      "speedMps": 20
    },
    {
      "id": "gone",
      "lane": -3,
      "s": 50,
      "speedMps": 20
    }
  ],
  "interactions": [
    {
      "id": "remove",
      "actorId": "gone",
      "verb": "exist",
      "target": {
        "state": "absent"
      },
      "trigger": {
        "kind": "at",
        "t": 2
      }
    }
  ],
  "oracle": {
    "clauses": [
      "DeleteEntityAction (class reference)",
      "SimulationTimeCondition (class reference)"
    ],
    "derivation": "DeleteEntityAction triggered at t=2.0 is instantaneous; with D-01 the t=2.0 sample is pre-action, so the entity is present up to and including t=2.0 and absent from t=2.02.",
    "actors": {
      "ego": {
        "x0": 50,
        "y0": -5.25,
        "v0": 20
      },
      "gone": {
        "x0": 50,
        "y0": -8.75,
        "v0": 20,
        "deletedAtS": 2.0
      }
    },
    "events": {
      "remove": {
        "start": 2.0
      }
    },
    "decisions": [
      "D-01",
      "D-09"
    ]
  },
  "expect": {
    "ours": "conforms",
    "esmini": "agrees"
  }
}
