{
  "id": "trigger-distance-euclidean",
  "feature": "RelativeDistanceCondition euclidean, freespace",
  "osc": [
    "RelativeDistanceCondition.euclidianDistance",
    "freespace=true",
    "conditionEdge.none"
  ],
  "description": "Ego (lane -2, 20 m/s) closes on a car in lane -1 (100 m ahead, 10 m/s). When distance < 40.5 m ego slows to 10 m/s.",
  "clipSeconds": 10,
  "actors": [
    {
      "id": "ego",
      "lane": -2,
      "s": 50,
      "speedMps": 20
    },
    {
      "id": "lead",
      "lane": -1,
      "s": 150,
      "speedMps": 10
    }
  ],
  "interactions": [
    {
      "id": "change",
      "actorId": "ego",
      "verb": "speed",
      "target": {
        "mode": "absolute",
        "value": 10
      },
      "dynamics": {
        "shape": "cubic",
        "constraint": "time",
        "value": 3
      },
      "trigger": {
        "kind": "when",
        "condition": {
          "kind": "distance",
          "a": "ego",
          "b": "lead",
          "mode": "euclidean",
          "cmp": "lt",
          "value": 40.5
        },
        "byLatest": 1000,
        "ifNever": "fire"
      }
    }
  ],
  "oracle": {
    "clauses": [
      "RelativeDistanceCondition (class reference: freespace, relativeDistanceType, coordinateSystem)",
      "7.6.1 Triggers and condition groups (OR of groups, AND within)",
      "7.6.2 Condition edges",
      "6.3.4 Vehicle coordinate system (reference point; BoundingBox.Center offset)"
    ],
    "derivation": "freespace: distance between the 4.8x1.9 m bounding boxes. Lateral gap 3.5-1.9 = 1.6 m, longitudinal gap 100-10t-4.8, so d = hypot(95.2-10t, 1.6). d < 40.5 first at t=5.48 (5.46 gives 40.63). Ego then 20->10 m/s cubic over 3 s.",
    "actors": {
      "ego": {
        "x0": 50,
        "y0": -5.25,
        "v0": 20,
        "longitudinal": [
          {
            "t0": 5.48,
            "to": 10,
            "shape": "cubic",
            "durationS": 3
          }
        ]
      },
      "lead": {
        "x0": 150,
        "y0": -1.75,
        "v0": 10
      }
    },
    "events": {
      "change": {
        "start": 5.48
      }
    },
    "decisions": [
      "D-05",
      "D-06"
    ]
  },
  "expect": {
    "ours": "conforms",
    "esmini": "agrees",
    "note": "The engine uses circumscribed circles (F-04), exported with a distance_metric_approximated warning; here it lands within one tick."
  }
}
