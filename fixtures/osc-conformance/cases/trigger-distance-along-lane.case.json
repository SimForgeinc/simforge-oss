{
  "id": "trigger-distance-along-lane",
  "feature": "RelativeDistanceCondition longitudinal (road), freespace",
  "osc": [
    "RelativeDistanceCondition.longitudinal",
    "coordinateSystem.road",
    "freespace=true"
  ],
  "description": "Ego (20 m/s) behind a car in the same lane (100 m ahead, 15 m/s). When the longitudinal distance < 40.5 m ego slows to 10 m/s.",
  "clipSeconds": 14,
  "actors": [
    {
      "id": "ego",
      "lane": -2,
      "s": 50,
      "speedMps": 20
    },
    {
      "id": "lead",
      "lane": -2,
      "s": 150,
      "speedMps": 15
    }
  ],
  "interactions": [
    {
      "id": "change",
      "actorId": "ego",
      "verb": "speed",
      "target": {
        "mode": "absolute",
        "value": 10
      },
      "dynamics": {
        "shape": "cubic",
        "constraint": "time",
        "value": 3
      },
      "trigger": {
        "kind": "when",
        "condition": {
          "kind": "distance",
          "a": "ego",
          "b": "lead",
          "mode": "alongLane",
          "cmp": "lt",
          "value": 40.5
        },
        "byLatest": 1000,
        "ifNever": "fire"
      }
    }
  ],
  "oracle": {
    "clauses": [
      "RelativeDistanceCondition (class reference: freespace, relativeDistanceType, coordinateSystem)",
      "7.6.1 Triggers and condition groups (OR of groups, AND within)",
      "7.6.2 Condition edges",
      "6.3.4 Vehicle coordinate system (reference point; BoundingBox.Center offset)"
    ],
    "derivation": "freespace longitudinal gap along the road = 100-5t-4.8. < 40.5 first at t=10.96 (t=10.94 gives exactly 40.5, not <).",
    "actors": {
      "ego": {
        "x0": 50,
        "y0": -5.25,
        "v0": 20,
        "longitudinal": [
          {
            "t0": 10.96,
            "to": 10,
            "shape": "cubic",
            "durationS": 3
          }
        ]
      },
      "lead": {
        "x0": 150,
        "y0": -5.25,
        "v0": 15
      }
    },
    "events": {
      "change": {
        "start": 10.96
      }
    },
    "decisions": [
      "D-05",
      "D-06"
    ]
  },
  "expect": {
    "ours": "conforms",
    "esmini": "agrees"
  }
}
