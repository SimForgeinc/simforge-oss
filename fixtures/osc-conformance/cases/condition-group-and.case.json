{
  "id": "condition-group-and",
  "feature": "ConditionGroup AND of Conditions",
  "osc": [
    "ConditionGroup (AND)",
    "RelativeDistanceCondition"
  ],
  "description": "Ego slows when within 40.5 m of car A AND within 45.5 m of car B.",
  "clipSeconds": 10,
  "actors": [
    {
      "id": "ego",
      "lane": -2,
      "s": 50,
      "speedMps": 20
    },
    {
      "id": "a",
      "lane": -1,
      "s": 150,
      "speedMps": 10
    },
    {
      "id": "b",
      "lane": -3,
      "s": 160,
      "speedMps": 10
    }
  ],
  "interactions": [
    {
      "id": "change",
      "actorId": "ego",
      "verb": "speed",
      "target": {
        "mode": "absolute",
        "value": 10
      },
      "dynamics": {
        "shape": "cubic",
        "constraint": "time",
        "value": 3
      },
      "trigger": {
