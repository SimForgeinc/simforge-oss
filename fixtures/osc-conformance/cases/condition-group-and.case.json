              "cmp": "lt",
              "value": 45.5
            }
          ]
        },
        "byLatest": 1000,
        "ifNever": "fire"
      }
    }
  ],
  "oracle": {
    "clauses": [
      "RelativeDistanceCondition (class reference: freespace, relativeDistanceType, coordinateSystem)",
      "7.6.1 Triggers and condition groups (OR of groups, AND within)",
      "7.6.2 Condition edges",
      "6.3.4 Vehicle coordinate system (reference point; BoundingBox.Center offset)"
    ],
    "derivation": "Freespace distances. A: true from 5.48. B: hypot(105.2-10t, 1.6) < 45.5 first at 5.98 (5.96 gives 45.63). AND -> 5.98; A still holds (35.4 m).",
    "actors": {
      "ego": {
        "x0": 50,
        "y0": -5.25,
        "v0": 20,
        "longitudinal": [
          {
            "t0": 5.98,
            "to": 10,
            "shape": "cubic",
            "durationS": 3
          }
        ]
      },
      "a": {
        "x0": 150,
        "y0": -1.75,
        "v0": 10
      },
      "b": {
        "x0": 160,
        "y0": -8.75,
        "v0": 10
      }
    },
    "events": {
      "change": {
        "start": 5.98
      }
    },
    "decisions": [
      "D-05",
      "D-06"
    ]
  },
  "expect": {
    "ours": "conforms",
    "esmini": "agrees",
    "esminiNote": "before the F-10 fix our export marked both conditions rising; an AND of two rising edges needs both to rise on one tick, so esmini (correctly for that file) never started the event"
  }
