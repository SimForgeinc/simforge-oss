    "derivation": "Headway = distance / speed of the triggering entity; freespace: bounding-box gap (100-5t-4.8)/20. < 3.013 first at t=7.00 (6.98 gives 3.015). Cubic 20->15 over [7, 10].",
    "actors": {
      "ego": {
        "x0": 50,
        "y0": -5.25,
        "v0": 20,
        "longitudinal": [
          {
            "t0": 7.0,
            "to": 15,
            "shape": "cubic",
            "durationS": 3
          }
        ]
      },
      "lead": {
        "x0": 150,
        "y0": -5.25,
        "v0": 15
      }
    },
    "events": {
      "change": {
        "start": 7.0
      }
    },
    "decisions": [
      "D-01",
      "D-06"
    ]
  },
  "expect": {
    "ours": "conforms",
    "esmini": "agrees"
  }
