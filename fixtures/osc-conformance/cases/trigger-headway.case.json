{
  "id": "trigger-headway",
  "feature": "TimeHeadwayCondition, freespace=false",
  "osc": [
    "TimeHeadwayCondition",
    "freespace=false"
  ],
  "description": "Ego (20 m/s) behind a car in the same lane (100 m ahead, 15 m/s). When headway < 3.013 s ego slows to 15 m/s.",
  "clipSeconds": 11,
  "actors": [
    {
      "id": "ego",
      "lane": -2,
      "s": 50,
      "speedMps": 20
    },
    {
      "id": "lead",
      "lane": -2,
      "s": 150,
      "speedMps": 15
    }
  ],
  "interactions": [
