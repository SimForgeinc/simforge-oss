{
  "name": "@simforge-oss/studio",
  "version": "0.1.10-preview.2",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "node scripts/sync-studio-assets.mjs && tsx scripts/boot.ts",
    "dev:next": "node scripts/sync-studio-assets.mjs && next dev --webpack -p ${PORT:-5199}",
    "build": "node scripts/sync-studio-assets.mjs && next build --webpack",
    "start": "tsx scripts/start.ts",
    "host:stop": "tsx scripts/stop-local-host.ts",
    "host:open": "tsx scripts/open-local-host.ts",
    "desktop": "electron .",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:stage": "node desktop/stage.mjs",
    "desktop:encoders": "node desktop/build-encoders.mjs",
    "desktop:dist": "node desktop/stage.mjs && electron-builder --config desktop/electron-builder.yml --publish never",
    "desktop:verify": "node desktop/verify-package.mjs",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "bootstrap:maps": "tsx scripts/bootstrap-public-maps.ts",
    "worker": "tsx worker/index.ts",
    "worker:harness": "tsx worker/harness.ts",
    "worker:model-run": "tsx scripts/model-run-worker.ts",
    "worker:hifi-preview": "tsx scripts/hifi-preview-worker.ts",
    "test:models": "tsx --test app/lib/models/__tests__/model-run-store.test.ts worker/__tests__/model-run-loop.test.ts",
    "test:map-cache": "tsx --test app/lib/map-cache/__tests__/service.test.ts && node --test desktop/__tests__/map-cache.test.mjs",
    "test:eval": "tsx --test app/lib/evaluation/__tests__/eval-api.test.ts",
    "test:hifi-preview": "tsx --test app/lib/hifi-preview/__tests__/camera-roundtrip.test.ts worker/__tests__/native-ready-map.test.ts worker/__tests__/payload-framing.test.ts",
    "test:fresh-schema": "node --conditions=development --conditions=react-server --import tsx --test app/lib/db/__tests__/map-asset-enrichment-fresh-schema.test.ts",
    "test:onboarding": "tsx --test app/lib/host/__tests__/onboarding-gate.test.ts app/components/map-preparation/__tests__/useMapPreparation.test.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@mapbox/vector-tile": "^2.0.4",
    "@msgpack/msgpack": "^3.1.3",
    "@napi-rs/keyring": "2.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@simforge-oss/asset-catalog": "workspace:*",
    "@simforge-oss/compiler": "workspace:*",
    "@simforge-oss/editor": "workspace:*",
    "@simforge-oss/engine": "workspace:*",
    "@simforge-oss/evaluation": "workspace:*",
    "@simforge-oss/maps": "workspace:*",
    "@simforge-oss/model-store": "workspace:*",
    "@simforge-oss/native-runtime": "workspace:*",
    "@simforge-oss/openscenario": "workspace:*",
    "@simforge-oss/playback": "workspace:*",
    "@simforge-oss/render": "workspace:*",
    "@simforge-oss/scenario": "workspace:*",
    "@simforge-oss/studio-host": "workspace:*",
    "@simforge-oss/studio-ui": "workspace:*",
    "@simforge-oss/training-env": "workspace:*",
    "@simforge-oss/viewer": "workspace:*",
    "@stylexjs/stylex": "^0.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "draco3dgltf": "^1.5.7",
    "earcut": "^3.0.2",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.5.6",
    "fflate": "^0.8.2",
    "flatbush": "^4.5.1",
    "gl-matrix": "^3.4.4",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "6.4.1",
    "meshoptimizer": "^1.0.1",
    "next": "16.3.4",
    "pbf": "^4.0.1",
    "pg": "^8.16.3",
    "playwright-core": "^1.62.1",
    "polygon-clipping": "^0.15.7",
    "polyline-normals": "^2.0.2",
    "proj4": "^2.19.10",
    "proper-lockfile": "^4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "8.1.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "0.185.1",
    "uuid": "^13.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.26.8",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "autoprefixer": "^10.4.27",
    "babel-loader": "^10.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.31",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.5",
    "typescript": "6.0.2",
    "vitest": "^3.0.0"
  }
}
