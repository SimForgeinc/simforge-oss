{
  "name": "@simforge-oss/studio",
  "version": "0.1.10-preview.2",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "node scripts/sync-studio-assets.mjs && tsx ../packages/cli/src/main.ts daemon --dev",
    "build": "node scripts/sync-studio-assets.mjs && next build --webpack",
    "desktop": "electron .",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:stage": "node desktop/stage.mjs",
    "desktop:encoders": "node desktop/build-encoders.mjs",
    "desktop:icons": "node desktop/build-icons.mjs",
    "desktop:pages": "node desktop/build-shell-pages.mjs",
    "desktop:dist": "node desktop/stage.mjs && electron-builder --config desktop/electron-builder.yml --publish never",
    "desktop:verify": "node desktop/verify-package.mjs",
    "migrate": "tsx scripts/migrate.ts",
    "retention:refs": "tsx scripts/retention-refs.ts",
    "test:migrations": "node --conditions=development --import tsx --test scripts/__tests__/migration-plan.test.ts",
    "seed": "tsx scripts/seed.ts",
    "bootstrap:maps": "tsx scripts/bootstrap-public-maps.ts",
    "verify:map-install": "tsx scripts/verify-map-install.ts",
    "verify:asset-loading": "tsx scripts/verify-asset-loading.ts",
    "verify:render-submit": "tsx scripts/verify-render-submit.ts",
    "verify:texture-tiers": "tsx scripts/verify-texture-tiers.ts",
    "verify:texture-tier-trace": "tsx scripts/verify-texture-tier-trace.ts",
    "verify:texture-tier-calibration": "tsx --test scripts/texture-tier-assertions.test.ts scripts/texture-frame-quality.test.ts",
    "verify:texture-container-reuse": "tsx scripts/verify-texture-container-reuse.ts",
    "verify:native-texture-tiers": "tsx scripts/verify-native-texture-tiers.ts",
    "verify:ml-texture-tiers": "tsx scripts/verify-native-texture-tiers.ts --profile=ml",
    "verify:viewer-context-lifetime": "tsx scripts/verify-viewer-context-lifetime.ts",
    "verify:drive-activity": "tsx scripts/verify-drive-activity.ts",
    "verify:world-retention": "tsx scripts/verify-world-retention.ts",
    "verify:frame-readability": "tsx scripts/verify-frame-readability.ts",
    "verify:all-texture-tiers": "tsx scripts/verify-all-texture-tiers.ts",
    "worker": "tsx worker/index.ts",
    "worker:harness": "tsx worker/harness.ts",
    "worker:model-run": "tsx scripts/model-run-worker.ts",
    "worker:hifi-preview": "tsx scripts/hifi-preview-worker.ts",
    "test:models": "node --conditions=development --import tsx --test app/lib/models/__tests__/model-run-store.test.ts worker/__tests__/model-run-loop.test.ts",
    "test:map-descriptor": "node --conditions=development --import tsx --test app/lib/map-ingest/server/__tests__/ground-descriptor.test.ts app/lib/scenario/__tests__/digest-attestation.test.ts",
    "test:map-cache": "node --conditions=development --import tsx --test app/lib/map-cache/__tests__/service.test.ts && node --conditions=development --import tsx --test desktop/__tests__/map-cache.test.mjs",
    "test:gallery-scope": "node --conditions=development --import tsx --test app/lib/scenario/render/__tests__/gallery-scope.test.ts",
    "test:eval": "node --conditions=development --import tsx --test app/lib/evaluation/__tests__/eval-api.test.ts",
    "test:dev-emit": "node --test dev-atomic-emit.test.mjs",
    "test:host-protocol": "node --conditions=development --import tsx --test worker/__tests__/host-protocol.test.ts",
    "test:live-world-worker": "node --experimental-test-module-mocks --conditions=development --import tsx --test worker/__tests__/live-world-worker-startup.test.ts",
    "test:worker-token": "node --conditions=development --conditions=react-server --import tsx --test app/lib/scenario/__tests__/worker-token.test.ts",
    "test:native-map": "node --conditions=development --import tsx --test worker/__tests__/native-map-materialization.test.ts",
    "test:hifi-preview": "node --conditions=development --import tsx --test app/lib/hifi-preview/__tests__/camera-roundtrip.test.ts worker/__tests__/native-ready-map.test.ts worker/__tests__/payload-framing.test.ts",
    "test:pglite-crash-safety": "node --conditions=development --conditions=react-server --import tsx --test app/lib/db/__tests__/pglite-crash-safety.test.ts",
    "test:fresh-schema": "node --conditions=development --conditions=react-server --import tsx --test app/lib/db/__tests__/map-asset-enrichment-fresh-schema.test.ts",
    "test:onboarding": "node --conditions=development --import tsx --test app/host/local/__tests__/onboarding-gate.test.ts app/components/map-preparation/__tests__/useMapPreparation.test.ts",
    "test:connections": "node --conditions=development --import tsx --test desktop/__tests__/connections.test.mjs && node --conditions=development --import tsx --test app/lib/host/__tests__/pairing.test.ts",
    "test:worker-presence": "node --conditions=development --conditions=react-server --import tsx --test app/lib/scenario/__tests__/cpu-worker-presence.test.ts",
    "test:simulate-lane": "node --conditions=development --import tsx --test worker/__tests__/simulate-lane.test.ts worker/__tests__/simulate-lane.sumo.test.ts",
    "test:retention": "node --conditions=development --conditions=react-server --import tsx --test app/lib/db/__tests__/retention-refs.test.ts app/lib/db/__tests__/immutability-guards.test.ts",
    "test:sim-results": "node --conditions=development --conditions=react-server --import tsx --test app/lib/scenario/__tests__/sim-result-store.test.ts",
    "test:sim-retention": "node --conditions=development --conditions=react-server --import tsx --test app/lib/scenario/__tests__/sim-retention.test.ts",
    "sim:retention-gc": "node --conditions=react-server --import tsx scripts/sim-retention-gc.ts",
    "test:sim-history": "node --conditions=development --conditions=react-server --import tsx --test app/lib/scenario/__tests__/sim-history.test.ts",
    "test:map-transition": "node --conditions=development --conditions=react-server --import tsx --test app/lib/scenario/__tests__/map-transition.test.ts",
    "test:worker-prewarm": "node --conditions=development --conditions=react-server --import tsx --test app/lib/scenario/__tests__/workers-prewarm.test.ts app/lib/scenario/__tests__/map-derivatives.test.ts app/lib/scenario/__tests__/native-texture-tier.test.ts app/lib/scenario/__tests__/native-admission.test.ts app/lib/scenario/__tests__/evidence-tolerant.test.ts app/lib/scenario/__tests__/render-worker-rtx3090-lease.test.ts app/lib/scenario/__tests__/render-evidence-completion.test.ts",
    "test:pinning": "node --conditions=development --conditions=react-server --import tsx --test app/lib/scenario/__tests__/document-pinning.test.ts app/lib/scenario/__tests__/schema-version-label.test.ts app/lib/scenario/__tests__/pg/revision-race.pg.test.ts",
    "test:mirror-fix": "node --conditions=development --conditions=react-server --import tsx --test app/lib/scenario/__tests__/mirrored-import-fix.test.ts",
    "test:host-modules": "node --conditions=development --import tsx --test app/host/__tests__/host-modules.test.ts app/lib/host/__tests__/asset-gallery-actions.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:eval-compare": "node --conditions=development --import tsx --test app/lib/evaluation/__tests__/model-comparison.test.ts",
    "test:eval-launch": "node --conditions=development --import tsx --test app/lib/evaluation/__tests__/comparison-launch.test.ts"
  },
