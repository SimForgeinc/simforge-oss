<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for a Developer ID signed, notarized
     SimForge Studio.app: V8 JIT for Electron and the Electron-in-Node host,
     unsigned executable memory and library validation relaxed for the N-API
     addon, sharp and the renderer FFI dylib loaded from Resources. No camera,
     microphone, location or network-server entitlements: the app listens on
     loopback only and opens outbound HTTPS solely to the SimCloud origin the
     user connects to. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
