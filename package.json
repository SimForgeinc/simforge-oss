{
  "name": "simforge",
  "description": "Portable driving-scenario authoring, simulation, rendering, validation, and standards export toolkit.",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --filter @simforge-oss/studio dev",
    "dev:worker": "pnpm --filter @simforge-oss/studio worker",
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm meshy:smoke",
    "test:portable": "pnpm --filter @simforge-oss/scenario --filter @simforge-oss/engine --filter @simforge-oss/maps --filter @simforge-oss/viewer --filter @simforge-oss/editor --filter @simforge-oss/playback --filter @simforge-oss/asset-catalog --filter @simforge-oss/render --filter @simforge-oss/openscenario test && pnpm --filter @simforge-oss/cli test:portable",
    "test:render-presets:browser": "node scripts/verify-render-presets-browser.mjs",
    "typecheck": "pnpm -r typecheck",
    "render:export": "node scripts/export-render.mjs",
    "render:run": "pnpm --filter @simforge-oss/cli simforge render run",
    "render:worker": "pnpm --filter @simforge-oss/render-worker start",
    "render:batch": "node scripts/render-scenario-batch.mjs",
    "render:review": "node scripts/review-scenario-evidence.mjs",
    "trace:render": "node scripts/render-trace.mjs",
    "render:qualification": "node scripts/render-qualification.mjs",
    "verify:naming": "node scripts/verify-repository-naming.mjs",
    "verify:fresh-sumo": "node scripts/verify-fresh-launch-sumo.mjs",
    "maps:derivatives": "node scripts/build-map-derivatives.mjs",
    "maps:derivatives:smoke": "node scripts/smoke-map-derivative-toolchain.mjs",
    "release:manifest": "node scripts/release/generate-stack-manifest.mjs --out artifacts/release/simforge-oss-stack.json",
    "release:verify-artifacts": "node scripts/release/verify-package-artifacts.mjs",
    "release:smoke-packages": "node scripts/release/smoke-packed-stack.mjs",
    "release:desktop": "node scripts/release/publish-desktop-release.mjs",
    "release:desktop-licenses": "node scripts/release/audit-bundled-licenses.mjs",
    "release:desktop-gates": "node scripts/release/stable-gates.mjs",
    "test:release": "node --test scripts/release/*.test.mjs",
    "meshy:generate": "node tools/meshy/generate.mjs",
    "meshy:smoke": "node --test tools/meshy/generate.test.mjs",
    "meshy:smoke:live": "node tools/meshy/live-smoke.mjs",
    "integration:audit": "node scripts/integration/audit-simcloud-divergence.mjs",
    "integration:compare-engine": "tsx scripts/integration/compare-engine-behavior.ts",
    "test:integration": "node --test scripts/integration/*.test.mjs",
    "e2e:smoke": "playwright test -c e2e/playwright.config.ts --project=smoke",
    "e2e:maps": "playwright test -c e2e/playwright.config.ts --project=maps",
    "e2e:models": "playwright test -c e2e/playwright.config.ts --project=models",
    "e2e:interop": "playwright test -c e2e/playwright.config.ts --project=interop",
    "e2e:all": "playwright test -c e2e/playwright.config.ts",
    "dev:all": "SIMFORGE_LOCAL_WORKER=1 pnpm --filter @simforge-oss/studio dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@simforge-oss/map-pipeline": "workspace:*",
    "playwright-core": "^1.62.1",
    "sharp": "0.34.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
